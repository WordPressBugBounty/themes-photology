{
	"$schema": "https://schemas.wp.org/wp/6.2/theme.json",
	"customTemplates": [],
	"settings": {
		"appearanceTools": true,
		"color": {
			"gradients": [],
			"palette": [{"slug":"theme-0","name":"Primary","color":"#343333"},{"slug":"theme-1","name":" Secondary","color":"#ffffff"},{"slug":"theme-2","name":"Brown","color":"#916c3d"},{"slug":"theme-3","name":"Brown Soft","color":"#d1c8bb"},{"slug":"theme-4","name":"Text","color":"#8b8b8b"},{"slug":"theme-5","name":" Text Hero","color":"#c2babb"},{"slug":"theme-6","name":"Text Footer","color":"#949494"},{"slug":"theme-7","name":"Soft Grey","color":"#f8f8f8"},{"slug":"theme-8","name":"Overlay","color":"#000000b3"},{"slug":"theme-9","name":"Border Dark","color":"#262626"},{"slug":"theme-10","name":"Background Overlay","color":"#030303"},{"slug":"theme-11","name":"Background Grey","color":"#e9e9e9"},{"slug":"theme-12","name":"Quote","color":"#f1f1f1"}]
		},
		"custom": {
