								"fontWeight": "regular",
								"src": [
									"file:./assets/fonts/prata/prata-v20-latin-regular.woff2"
								]
							}
					],
					"fontFamily": "Prata",
					"name": "Prata",
					"slug": "prata"
				},{
					"fontFace": [
						{
								"fontFamily": "Heebo",
